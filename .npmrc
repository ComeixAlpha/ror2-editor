# pnpm reads most of its settings from pnpm-workspace.yaml now (pnpm 10+).
# This file only holds registry-connection options for this machine's environment.
#
# The dev machine reaches the npm registry through a local proxy. Node does not honour the
# Windows system proxy, so without this pnpm fails with "invalid peer certificate: UnknownIssuer"
# when connecting directly. Set these to match your environment, or delete the file if you have
# direct registry access.
#
# proxy=http://127.0.0.1:7890
# https-proxy=http://127.0.0.1:7890

# Keep the dependency tree close to what npm produced, so any transitive dependency that resolved
# by walking up node_modules still resolves.
hoist-pattern[]=*

strict-peer-dependencies=false
